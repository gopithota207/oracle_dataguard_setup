#!/bin/bash
# =============================================================================
#  Oracle Data Guard Automation Script - Primary to Standby Setup
#  Supports : Oracle 12c / 18c / 19c / 21c on Linux
#  Usage    : sudo ./oracle_dataguard_setup.sh [OPTIONS]
# 
# =============================================================================

set -euo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURATION — Edit these variables to match your environment
# ─────────────────────────────────────────────────────────────────────────────

# PRIMARY Database
PRIMARY_ORACLE_HOME="${PRIMARY_ORACLE_HOME:-/u01/app/oracle/product/19.3.0/dbhome_1}"
PRIMARY_ORACLE_BASE="${PRIMARY_ORACLE_BASE:-/u01/app/oracle}"
PRIMARY_SID="${PRIMARY_SID:-ORCL}"
PRIMARY_DB_UNIQUE_NAME="${PRIMARY_DB_UNIQUE_NAME:-ORCL_PRIMARY}"
PRIMARY_HOST="${PRIMARY_HOST:-primary-db-host}"
PRIMARY_PORT="${PRIMARY_PORT:-1521}"

# STANDBY Database
STANDBY_ORACLE_HOME="${STANDBY_ORACLE_HOME:-/u01/app/oracle/product/19.3.0/dbhome_1}"
STANDBY_ORACLE_BASE="${STANDBY_ORACLE_BASE:-/u01/app/oracle}"
STANDBY_SID="${STANDBY_SID:-ORCLSTBY}"
STANDBY_DB_UNIQUE_NAME="${STANDBY_DB_UNIQUE_NAME:-ORCL_STANDBY}"
STANDBY_HOST="${STANDBY_HOST:-standby-db-host}"
STANDBY_PORT="${STANDBY_PORT:-1521}"

# Oracle OS User
ORACLE_USER="${ORACLE_USER:-oracle}"

# Data Guard Protection Mode
# MaxProtection / MaxAvailability / MaxPerformance
DG_PROTECTION_MODE="${DG_PROTECTION_MODE:-MaxPerformance}"

# RMAN Duplicate method: ACTIVE (network) or BACKUP (from backup)
DUPLICATE_METHOD="${DUPLICATE_METHOD:-ACTIVE}"

# Directories
LOG_DIR="${LOG_DIR:-/u01/dataguard/logs}"
BACKUP_DIR="${BACKUP_DIR:-/u01/dataguard/backup}"

# Mail recipient
MAIL_TO="${MAIL_TO:-}"

# ─────────────────────────────────────────────────────────────────────────────
# INTERNAL GLOBALS
# ─────────────────────────────────────────────────────────────────────────────
SCRIPT_NAME="$(basename "$0")"
START_TS="$(date '+%Y%m%d_%H%M%S')"
LOG_FILE="${LOG_DIR}/dataguard_setup_${START_TS}.log"
REPORT_FILE="${LOG_DIR}/dataguard_report_${START_TS}.txt"
SQLPLUS="${PRIMARY_ORACLE_HOME}/bin/sqlplus"
RMAN="${PRIMARY_ORACLE_HOME}/bin/rman"
STEP_ERRORS=0

# Colour codes
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING HELPERS
# ─────────────────────────────────────────────────────────────────────────────
mkdir -p "$LOG_DIR" "$BACKUP_DIR"

log()   { local msg="[$(date '+%Y-%m-%d %H:%M:%S')] $*"; echo "$msg" | tee -a "$LOG_FILE"; }
info()  { echo -e "${CYAN}[INFO]${RESET}  $*";  log "[INFO]  $*"; }
ok()    { echo -e "${GREEN}[OK]${RESET}    $*";  log "[OK]    $*"; }
warn()  { echo -e "${YELLOW}[WARN]${RESET}  $*"; log "[WARN]  $*"; }
error() { echo -e "${RED}[ERROR]${RESET} $*" >&2; log "[ERROR] $*"; (( STEP_ERRORS++ )); }
die()   { error "$*"; send_report "FAILED"; exit 1; }
sep()   { echo -e "${BOLD}$(printf '=%.0s' {1..72})${RESET}"; log "$(printf '=%.0s' {1..72})"; }

# ─────────────────────────────────────────────────────────────────────────────
# SIGNAL TRAP
# ─────────────────────────────────────────────────────────────────────────────
cleanup() {
    warn "Script interrupted!"
    send_report "INTERRUPTED"
    exit 130
}
trap cleanup INT TERM

# ─────────────────────────────────────────────────────────────────────────────
# UTILITY: Run as oracle user on PRIMARY
# ─────────────────────────────────────────────────────────────────────────────
run_primary() {
    sudo -u "$ORACLE_USER" bash -c "
        export ORACLE_BASE='$PRIMARY_ORACLE_BASE'
        export ORACLE_HOME='$PRIMARY_ORACLE_HOME'
        export ORACLE_SID='$PRIMARY_SID'
        export PATH=\$ORACLE_HOME/bin:\$PATH
        $*
    "
}

# ─────────────────────────────────────────────────────────────────────────────
# UTILITY: Run as oracle user on STANDBY (via SSH)
# ─────────────────────────────────────────────────────────────────────────────
run_standby() {
    ssh -o StrictHostKeyChecking=no "${ORACLE_USER}@${STANDBY_HOST}" "
        export ORACLE_BASE='$STANDBY_ORACLE_BASE'
        export ORACLE_HOME='$STANDBY_ORACLE_HOME'
        export ORACLE_SID='$STANDBY_SID'
        export PATH=\$ORACLE_HOME/bin:\$PATH
        $*
    "
}

# ─────────────────────────────────────────────────────────────────────────────
# UTILITY: SQL*Plus on PRIMARY
# ─────────────────────────────────────────────────────────────────────────────
sqlplus_primary() {
    run_primary "$SQLPLUS -s / as sysdba <<'SQLEOF'
SET PAGESIZE 0 FEEDBACK OFF HEADING OFF VERIFY OFF ECHO OFF
$1
EXIT;
SQLEOF"
}

# ─────────────────────────────────────────────────────────────────────────────
# UTILITY: SQL*Plus on STANDBY
# ─────────────────────────────────────────────────────────────────────────────
sqlplus_standby() {
    run_standby "$STANDBY_ORACLE_HOME/bin/sqlplus -s / as sysdba <<'SQLEOF'
SET PAGESIZE 0 FEEDBACK OFF HEADING OFF VERIFY OFF ECHO OFF
$1
EXIT;
SQLEOF"
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 0 — PREFLIGHT CHECKS
# ─────────────────────────────────────────────────────────────────────────────
preflight() {
    sep
    info "STEP 0 — Pre-flight Checks"
    sep

    # Must run as root
    [[ $EUID -eq 0 ]] || die "Script must be run as root (sudo)."

    # Oracle user exists
    id "$ORACLE_USER" &>/dev/null || die "OS user '$ORACLE_USER' not found."

    # Oracle Home exists
    [[ -d "$PRIMARY_ORACLE_HOME" ]] || die "PRIMARY_ORACLE_HOME not found: $PRIMARY_ORACLE_HOME"
    [[ -x "$SQLPLUS" ]]             || die "sqlplus not found: $SQLPLUS"

    # SSH connectivity to standby
    info "Testing SSH connectivity to standby host: $STANDBY_HOST ..."
    if ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 \
        "${ORACLE_USER}@${STANDBY_HOST}" "echo SSH_OK" 2>/dev/null | grep -q "SSH_OK"; then
        ok "SSH connectivity to $STANDBY_HOST — OK"
    else
        die "Cannot SSH to standby host $STANDBY_HOST as $ORACLE_USER. Setup passwordless SSH first."
    fi

    # Check primary DB is OPEN
    local db_status
    db_status=$(sqlplus_primary "SELECT STATUS FROM V\$INSTANCE;" 2>/dev/null | tr -d '[:space:]')
    [[ "$db_status" == "OPEN" ]] || die "Primary database is not OPEN. Status: $db_status"
    ok "Primary database status: OPEN"

    # Disk space check
    local free_kb
    free_kb=$(df -k "$PRIMARY_ORACLE_HOME" | awk 'NR==2{print $4}')
    (( free_kb >= 10485760 )) && ok "Disk space OK on primary." \
        || warn "Less than 10GB free on primary. Proceeding anyway."

    ok "Pre-flight checks complete."
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 1 — ENABLE ARCHIVELOG MODE ON PRIMARY
# ─────────────────────────────────────────────────────────────────────────────
enable_archivelog() {
    sep
    info "STEP 1 — Enable ARCHIVELOG Mode on Primary"
    sep

    local log_mode
    log_mode=$(sqlplus_primary "SELECT LOG_MODE FROM V\$DATABASE;" \
               2>/dev/null | tr -d '[:space:]')

    if [[ "$log_mode" == "ARCHIVELOG" ]]; then
        ok "Primary is already in ARCHIVELOG mode."
        return 0
    fi

    info "Switching primary to ARCHIVELOG mode..."
    sqlplus_primary "SHUTDOWN IMMEDIATE;" 2>/dev/null || warn "Shutdown warning."
    sqlplus_primary "STARTUP MOUNT;"      2>/dev/null || die "STARTUP MOUNT failed."
    sqlplus_primary "ALTER DATABASE ARCHIVELOG;" 2>/dev/null || die "ARCHIVELOG enable failed."
    sqlplus_primary "ALTER DATABASE OPEN;"        2>/dev/null || die "ALTER DATABASE OPEN failed."

    ok "ARCHIVELOG mode enabled on primary."
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 2 — ENABLE FORCE LOGGING ON PRIMARY
# ─────────────────────────────────────────────────────────────────────────────
enable_force_logging() {
    sep
    info "STEP 2 — Enable FORCE LOGGING on Primary"
    sep

    sqlplus_primary "ALTER DATABASE FORCE LOGGING;" \
        2>/dev/null || die "FORCE LOGGING failed."

    local fl
    fl=$(sqlplus_primary "SELECT FORCE_LOGGING FROM V\$DATABASE;" \
         2>/dev/null | tr -d '[:space:]')
    [[ "$fl" == "YES" ]] && ok "FORCE LOGGING enabled." \
        || warn "FORCE LOGGING may not be set. Check manually."
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 3 — CONFIGURE PRIMARY INIT PARAMETERS
# ─────────────────────────────────────────────────────────────────────────────
configure_primary_params() {
    sep
    info "STEP 3 — Configure Primary Database Parameters"
    sep

    sqlplus_primary "
        ALTER SYSTEM SET DB_UNIQUE_NAME='$PRIMARY_DB_UNIQUE_NAME' SCOPE=SPFILE;
        ALTER SYSTEM SET LOG_ARCHIVE_CONFIG='DG_CONFIG=($PRIMARY_DB_UNIQUE_NAME,$STANDBY_DB_UNIQUE_NAME)' SCOPE=BOTH;
        ALTER SYSTEM SET LOG_ARCHIVE_DEST_1='LOCATION=USE_DB_RECOVERY_FILE_DEST VALID_FOR=(ALL_LOGFILES,ALL_ROLES) DB_UNIQUE_NAME=$PRIMARY_DB_UNIQUE_NAME' SCOPE=BOTH;
        ALTER SYSTEM SET LOG_ARCHIVE_DEST_2='SERVICE=$STANDBY_DB_UNIQUE_NAME ASYNC VALID_FOR=(ONLINE_LOGFILES,PRIMARY_ROLE) DB_UNIQUE_NAME=$STANDBY_DB_UNIQUE_NAME' SCOPE=BOTH;
        ALTER SYSTEM SET LOG_ARCHIVE_DEST_STATE_1=ENABLE SCOPE=BOTH;
        ALTER SYSTEM SET LOG_ARCHIVE_DEST_STATE_2=ENABLE SCOPE=BOTH;
        ALTER SYSTEM SET REMOTE_LOGIN_PASSWORDFILE=EXCLUSIVE SCOPE=SPFILE;
        ALTER SYSTEM SET LOG_ARCHIVE_FORMAT='%t_%s_%r.dbf' SCOPE=SPFILE;
        ALTER SYSTEM SET LOG_ARCHIVE_MAX_PROCESSES=4 SCOPE=BOTH;
        ALTER SYSTEM SET STANDBY_FILE_MANAGEMENT=AUTO SCOPE=BOTH;
        ALTER SYSTEM SET FAL_SERVER='$STANDBY_DB_UNIQUE_NAME' SCOPE=BOTH;
        ALTER SYSTEM SET FAL_CLIENT='$PRIMARY_DB_UNIQUE_NAME' SCOPE=BOTH;
        ALTER SYSTEM SET DB_FILE_NAME_CONVERT='$STANDBY_DB_UNIQUE_NAME','$PRIMARY_DB_UNIQUE_NAME' SCOPE=SPFILE;
        ALTER SYSTEM SET LOG_FILE_NAME_CONVERT='$STANDBY_DB_UNIQUE_NAME','$PRIMARY_DB_UNIQUE_NAME' SCOPE=SPFILE;
    " 2>&1 | tee -a "$LOG_FILE" || die "Primary parameter configuration failed."

    ok "Primary database parameters configured."
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 4 — ADD STANDBY REDO LOGS ON PRIMARY
# ─────────────────────────────────────────────────────────────────────────────
add_standby_redo_logs() {
    sep
    info "STEP 4 — Add Standby Redo Log Groups on Primary"
    sep

    # Get online redo log size
    local log_size
    log_size=$(sqlplus_primary \
        "SELECT BYTES FROM V\$LOG WHERE ROWNUM=1;" \
        2>/dev/null | tr -d '[:space:]')
    log_size="${log_size:-52428800}"   # default 50MB

    info "Adding 4 Standby Redo Log groups (size: $(( log_size / 1048576 )) MB each)..."

    sqlplus_primary "
        ALTER DATABASE ADD STANDBY LOGFILE GROUP 10 SIZE $log_size;
        ALTER DATABASE ADD STANDBY LOGFILE GROUP 11 SIZE $log_size;
        ALTER DATABASE ADD STANDBY LOGFILE GROUP 12 SIZE $log_size;
        ALTER DATABASE ADD STANDBY LOGFILE GROUP 13 SIZE $log_size;
    " 2>&1 | tee -a "$LOG_FILE" || warn "Some standby redo log groups may already exist."

    ok "Standby redo log groups added on primary."
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 5 — CREATE & COPY PASSWORD FILE TO STANDBY
# ─────────────────────────────────────────────────────────────────────────────
copy_password_file() {
    sep
    info "STEP 5 — Copy Password File to Standby"
    sep

    local pwd_file="${PRIMARY_ORACLE_HOME}/dbs/orapw${PRIMARY_SID}"

    [[ -f "$pwd_file" ]] || die "Password file not found: $pwd_file"

    info "Copying password file to standby host $STANDBY_HOST ..."
    scp "$pwd_file" \
        "${ORACLE_USER}@${STANDBY_HOST}:${STANDBY_ORACLE_HOME}/dbs/orapw${STANDBY_SID}" \
        || die "Failed to copy password file to standby."

    ok "Password file copied to standby."
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 6 — CREATE STANDBY INIT PARAMETER FILE
# ─────────────────────────────────────────────────────────────────────────────
create_standby_pfile() {
    sep
    info "STEP 6 — Create Standby Init Parameter File"
    sep

    local pfile="/tmp/init${STANDBY_SID}.ora"

    cat > "$pfile" <<PFILE
*.DB_NAME='$PRIMARY_SID'
*.DB_UNIQUE_NAME='$STANDBY_DB_UNIQUE_NAME'
*.ORACLE_BASE='$STANDBY_ORACLE_BASE'
*.DB_RECOVERY_FILE_DEST='$STANDBY_ORACLE_BASE/fast_recovery_area'
*.DB_RECOVERY_FILE_DEST_SIZE=50G
*.AUDIT_FILE_DEST='$STANDBY_ORACLE_BASE/admin/$STANDBY_SID/adump'
*.DIAGNOSTIC_DEST='$STANDBY_ORACLE_BASE'
*.CONTROL_FILES='$STANDBY_ORACLE_BASE/oradata/$STANDBY_SID/control01.ctl','$STANDBY_ORACLE_BASE/fast_recovery_area/$STANDBY_SID/control02.ctl'
*.LOG_ARCHIVE_CONFIG='DG_CONFIG=($PRIMARY_DB_UNIQUE_NAME,$STANDBY_DB_UNIQUE_NAME)'
*.LOG_ARCHIVE_DEST_1='LOCATION=USE_DB_RECOVERY_FILE_DEST VALID_FOR=(ALL_LOGFILES,ALL_ROLES) DB_UNIQUE_NAME=$STANDBY_DB_UNIQUE_NAME'
*.LOG_ARCHIVE_DEST_2='SERVICE=$PRIMARY_DB_UNIQUE_NAME ASYNC VALID_FOR=(ONLINE_LOGFILES,PRIMARY_ROLE) DB_UNIQUE_NAME=$PRIMARY_DB_UNIQUE_NAME'
*.LOG_ARCHIVE_DEST_STATE_1=ENABLE
*.LOG_ARCHIVE_DEST_STATE_2=ENABLE
*.REMOTE_LOGIN_PASSWORDFILE=EXCLUSIVE
*.STANDBY_FILE_MANAGEMENT=AUTO
*.FAL_SERVER='$PRIMARY_DB_UNIQUE_NAME'
*.FAL_CLIENT='$STANDBY_DB_UNIQUE_NAME'
*.DB_FILE_NAME_CONVERT='$PRIMARY_DB_UNIQUE_NAME','$STANDBY_DB_UNIQUE_NAME'
*.LOG_FILE_NAME_CONVERT='$PRIMARY_DB_UNIQUE_NAME','$STANDBY_DB_UNIQUE_NAME'
PFILE

    info "Copying standby pfile to $STANDBY_HOST ..."
    scp "$pfile" \
        "${ORACLE_USER}@${STANDBY_HOST}:${STANDBY_ORACLE_HOME}/dbs/init${STANDBY_SID}.ora" \
        || die "Failed to copy pfile to standby."

    ok "Standby init parameter file created and copied."
    rm -f "$pfile"
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 7 — CONFIGURE TNS ON BOTH NODES
# ─────────────────────────────────────────────────────────────────────────────
configure_tns() {
    sep
    info "STEP 7 — Configure TNS (tnsnames.ora & listener.ora)"
    sep

    local tns_entry="
$PRIMARY_DB_UNIQUE_NAME =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = $PRIMARY_HOST)(PORT = $PRIMARY_PORT))
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = $PRIMARY_SID)
    )
  )

$STANDBY_DB_UNIQUE_NAME =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = $STANDBY_HOST)(PORT = $STANDBY_PORT))
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = $STANDBY_SID)
      (UR = A)
    )
  )
"
    local tns_file="${PRIMARY_ORACLE_HOME}/network/admin/tnsnames.ora"

    # Backup existing tnsnames
    [[ -f "$tns_file" ]] && cp "$tns_file" "${tns_file}.bak_${START_TS}"

    # Append entries
    echo "$tns_entry" >> "$tns_file"

    # Copy tnsnames to standby
    scp "$tns_file" \
        "${ORACLE_USER}@${STANDBY_HOST}:${STANDBY_ORACLE_HOME}/network/admin/tnsnames.ora" \
        || die "Failed to copy tnsnames.ora to standby."

    # Create listener.ora on standby
    local listener_entry="
LISTENER =
  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS = (PROTOCOL = TCP)(HOST = $STANDBY_HOST)(PORT = $STANDBY_PORT))
    )
  )

SID_LIST_LISTENER =
  (SID_LIST =
    (SID_DESC =
      (GLOBAL_DBNAME = ${STANDBY_SID}_DGMGRL)
      (ORACLE_HOME = $STANDBY_ORACLE_HOME)
      (SID_NAME = $STANDBY_SID)
    )
  )
"
    run_standby "echo '$listener_entry' > ${STANDBY_ORACLE_HOME}/network/admin/listener.ora"
    run_standby "${STANDBY_ORACLE_HOME}/bin/lsnrctl reload" 2>/dev/null || true

    ok "TNS configuration complete on both nodes."
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 8 — PREPARE STANDBY DIRECTORIES
# ─────────────────────────────────────────────────────────────────────────────
prepare_standby_dirs() {
    sep
    info "STEP 8 — Prepare Standby Directories"
    sep

    run_standby "
        mkdir -p ${STANDBY_ORACLE_BASE}/oradata/${STANDBY_SID}
        mkdir -p ${STANDBY_ORACLE_BASE}/fast_recovery_area/${STANDBY_SID}
        mkdir -p ${STANDBY_ORACLE_BASE}/admin/${STANDBY_SID}/adump
        mkdir -p ${STANDBY_ORACLE_BASE}/admin/${STANDBY_SID}/bdump
        mkdir -p ${STANDBY_ORACLE_BASE}/admin/${STANDBY_SID}/cdump
        mkdir -p ${STANDBY_ORACLE_BASE}/admin/${STANDBY_SID}/udump
        chmod -R 755 ${STANDBY_ORACLE_BASE}/oradata
        chmod -R 755 ${STANDBY_ORACLE_BASE}/fast_recovery_area
    " || die "Failed to create standby directories."

    ok "Standby directories created."
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 9 — START STANDBY IN NOMOUNT
# ─────────────────────────────────────────────────────────────────────────────
start_standby_nomount() {
    sep
    info "STEP 9 — Start Standby Database in NOMOUNT"
    sep

    run_standby "${STANDBY_ORACLE_HOME}/bin/sqlplus -s / as sysdba <<'EOF'
STARTUP NOMOUNT PFILE='${STANDBY_ORACLE_HOME}/dbs/init${STANDBY_SID}.ora';
EXIT;
EOF" 2>&1 | tee -a "$LOG_FILE" || die "Failed to start standby in NOMOUNT."

    ok "Standby database started in NOMOUNT."
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 10 — RMAN DUPLICATE (ACTIVE DATABASE)
# ─────────────────────────────────────────────────────────────────────────────
rman_duplicate() {
    sep
    info "STEP 10 — RMAN Duplicate Primary → Standby"
    sep

    local rman_log="${LOG_DIR}/rman_duplicate_${START_TS}.log"
    info "This step may take 30 minutes to several hours depending on DB size..."

    run_primary "$RMAN TARGET sys@${PRIMARY_DB_UNIQUE_NAME} \
        AUXILIARY sys@${STANDBY_DB_UNIQUE_NAME} <<'RMANEOF'
RUN {
  ALLOCATE CHANNEL c1 TYPE DISK;
  ALLOCATE CHANNEL c2 TYPE DISK;
  ALLOCATE AUXILIARY CHANNEL s1 TYPE DISK;
  ALLOCATE AUXILIARY CHANNEL s2 TYPE DISK;
  DUPLICATE TARGET DATABASE
    FOR STANDBY
    FROM ACTIVE DATABASE
    DORECOVER
    SPFILE
      PARAMETER_VALUE_CONVERT
        '$PRIMARY_DB_UNIQUE_NAME','$STANDBY_DB_UNIQUE_NAME',
        '$PRIMARY_SID','$STANDBY_SID'
      SET DB_UNIQUE_NAME='$STANDBY_DB_UNIQUE_NAME'
      SET DB_FILE_NAME_CONVERT=
        '$PRIMARY_DB_UNIQUE_NAME','$STANDBY_DB_UNIQUE_NAME'
      SET LOG_FILE_NAME_CONVERT=
        '$PRIMARY_DB_UNIQUE_NAME','$STANDBY_DB_UNIQUE_NAME'
      SET LOG_ARCHIVE_MAX_PROCESSES='4'
      SET STANDBY_FILE_MANAGEMENT='AUTO'
      SET FAL_SERVER='$PRIMARY_DB_UNIQUE_NAME'
    NOFILENAMECHECK;
}
RMANEOF" 2>&1 | tee -a "$rman_log" "$LOG_FILE" \
        || die "RMAN Duplicate failed. Check $rman_log"

    ok "RMAN Duplicate completed successfully."
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 11 — ADD STANDBY REDO LOGS ON STANDBY
# ─────────────────────────────────────────────────────────────────────────────
add_standby_redo_logs_standby() {
    sep
    info "STEP 11 — Add Standby Redo Logs on Standby"
    sep

    run_standby "${STANDBY_ORACLE_HOME}/bin/sqlplus -s / as sysdba <<'EOF'
ALTER DATABASE ADD STANDBY LOGFILE GROUP 10 SIZE 52428800;
ALTER DATABASE ADD STANDBY LOGFILE GROUP 11 SIZE 52428800;
ALTER DATABASE ADD STANDBY LOGFILE GROUP 12 SIZE 52428800;
ALTER DATABASE ADD STANDBY LOGFILE GROUP 13 SIZE 52428800;
EXIT;
EOF" 2>&1 | tee -a "$LOG_FILE" || warn "Some standby redo log groups may already exist."

    ok "Standby redo logs added on standby."
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 12 — START MANAGED RECOVERY (MRP)
# ─────────────────────────────────────────────────────────────────────────────
start_managed_recovery() {
    sep
    info "STEP 12 — Start Managed Recovery Process (MRP)"
    sep

    run_standby "${STANDBY_ORACLE_HOME}/bin/sqlplus -s / as sysdba <<'EOF'
ALTER DATABASE RECOVER MANAGED STANDBY DATABASE DISCONNECT FROM SESSION;
EXIT;
EOF" 2>&1 | tee -a "$LOG_FILE" || die "Failed to start MRP on standby."

    sleep 5

    # Verify MRP is running
    local mrp_status
    mrp_status=$(run_standby "${STANDBY_ORACLE_HOME}/bin/sqlplus -s / as sysdba <<'EOF'
SET PAGESIZE 0 FEEDBACK OFF HEADING OFF
SELECT PROCESS || '|' || STATUS FROM V\$MANAGED_STANDBY WHERE PROCESS='MRP0';
EXIT;
EOF" 2>/dev/null | tr -d '[:space:]')

    if echo "$mrp_status" | grep -q "MRP0"; then
        ok "MRP0 is running: $mrp_status"
    else
        warn "MRP0 status unclear — verify manually."
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 13 — CONFIGURE DATA GUARD BROKER
# ─────────────────────────────────────────────────────────────────────────────
configure_dgbroker() {
    sep
    info "STEP 13 — Configure Data Guard Broker (DGMGRL)"
    sep

    # Enable broker on primary
    sqlplus_primary "
        ALTER SYSTEM SET DG_BROKER_START=TRUE SCOPE=BOTH;
    " 2>/dev/null || warn "Could not enable DG broker on primary."

    # Enable broker on standby
    run_standby "${STANDBY_ORACLE_HOME}/bin/sqlplus -s / as sysdba <<'EOF'
ALTER SYSTEM SET DG_BROKER_START=TRUE SCOPE=BOTH;
EXIT;
EOF" 2>/dev/null || warn "Could not enable DG broker on standby."

    sleep 5

    # Create broker configuration
    run_primary "${PRIMARY_ORACLE_HOME}/bin/dgmgrl sys/oracle@${PRIMARY_DB_UNIQUE_NAME} <<'DGEOF'
CREATE CONFIGURATION 'DGConfig' AS
  PRIMARY DATABASE IS '$PRIMARY_DB_UNIQUE_NAME'
  CONNECT IDENTIFIER IS '$PRIMARY_DB_UNIQUE_NAME';

ADD DATABASE '$STANDBY_DB_UNIQUE_NAME' AS
  CONNECT IDENTIFIER IS '$STANDBY_DB_UNIQUE_NAME'
  MAINTAINED AS PHYSICAL;

ENABLE CONFIGURATION;
SHOW CONFIGURATION;
DGEOF" 2>&1 | tee -a "$LOG_FILE" || warn "DGMGRL config may need manual verification."

    ok "Data Guard Broker configured."
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 14 — SET PROTECTION MODE
# ─────────────────────────────────────────────────────────────────────────────
set_protection_mode() {
    sep
    info "STEP 14 — Set Protection Mode: $DG_PROTECTION_MODE"
    sep

    case "$DG_PROTECTION_MODE" in
        MaxProtection)
            sqlplus_primary "
                ALTER DATABASE SET STANDBY DATABASE TO MAXIMIZE PROTECTION;
            " 2>/dev/null || warn "MaxProtection mode set failed."
            ;;
        MaxAvailability)
            sqlplus_primary "
                ALTER DATABASE SET STANDBY DATABASE TO MAXIMIZE AVAILABILITY;
            " 2>/dev/null || warn "MaxAvailability mode set failed."
            ;;
        MaxPerformance)
            sqlplus_primary "
                ALTER DATABASE SET STANDBY DATABASE TO MAXIMIZE PERFORMANCE;
            " 2>/dev/null || warn "MaxPerformance mode set failed."
            ;;
    esac

    local prot_mode
    prot_mode=$(sqlplus_primary \
        "SELECT PROTECTION_MODE FROM V\$DATABASE;" \
        2>/dev/null | tr -d '[:space:]')
    info "Protection mode set to: $prot_mode"
    ok "Protection mode configured."
}

# ─────────────────────────────────────────────────────────────────────────────
# STEP 15 — VERIFY DATA GUARD SETUP
# ─────────────────────────────────────────────────────────────────────────────
verify_dataguard() {
    sep
    info "STEP 15 — Verify Data Guard Setup"
    sep

    # Primary status
    info "Primary DB status:"
    sqlplus_primary "
        SELECT NAME, DB_UNIQUE_NAME, OPEN_MODE, PROTECTION_MODE,
               DATABASE_ROLE, SWITCHOVER_STATUS
        FROM V\$DATABASE;
    " 2>/dev/null | tee -a "$LOG_FILE"

    # Standby status
    info "Standby DB status:"
    run_standby "${STANDBY_ORACLE_HOME}/bin/sqlplus -s / as sysdba <<'EOF'
SET LINESIZE 150 PAGESIZE 50
SELECT NAME, DB_UNIQUE_NAME, OPEN_MODE, DATABASE_ROLE FROM V\$DATABASE;
SELECT PROCESS, STATUS, THREAD#, SEQUENCE# FROM V\$MANAGED_STANDBY ORDER BY PROCESS;
EXIT;
EOF" 2>&1 | tee -a "$LOG_FILE"

    # Archive log gap check
    info "Archive log gap check:"
    sqlplus_primary "
        SELECT THREAD#, LOW_SEQUENCE#, HIGH_SEQUENCE#
        FROM V\$ARCHIVE_GAP;
    " 2>/dev/null | tee -a "$LOG_FILE"

    # Last applied log
    info "Last applied archive log on standby:"
    run_standby "${STANDBY_ORACLE_HOME}/bin/sqlplus -s / as sysdba <<'EOF'
SET PAGESIZE 50 LINESIZE 150
SELECT THREAD#, MAX(SEQUENCE#) AS LAST_APPLIED
FROM V\$ARCHIVED_LOG
WHERE APPLIED='YES'
GROUP BY THREAD#;
EXIT;
EOF" 2>/dev/null | tee -a "$LOG_FILE"

    ok "Data Guard verification complete."
}

# ─────────────────────────────────────────────────────────────────────────────
# REPORT
# ─────────────────────────────────────────────────────────────────────────────
send_report() {
    local status="$1"
    local end_ts; end_ts=$(date '+%Y-%m-%d %H:%M:%S')

    cat > "$REPORT_FILE" <<EOF
=======================================================================
 ORACLE DATA GUARD SETUP REPORT
=======================================================================
 Primary SID         : $PRIMARY_SID
 Primary Unique Name : $PRIMARY_DB_UNIQUE_NAME
 Primary Host        : $PRIMARY_HOST
 Standby SID         : $STANDBY_SID
 Standby Unique Name : $STANDBY_DB_UNIQUE_NAME
 Standby Host        : $STANDBY_HOST
 Protection Mode     : $DG_PROTECTION_MODE
 Duplicate Method    : $DUPLICATE_METHOD
 Status              : $status
 Started             : $START_TS
 Completed           : $end_ts
 Log File            : $LOG_FILE
 Step Errors         : $STEP_ERRORS
=======================================================================
 Review full log: $LOG_FILE
=======================================================================
EOF

    info "Report written to $REPORT_FILE"

    if [[ -n "$MAIL_TO" ]] && command -v mail &>/dev/null; then
        mail -s "Oracle Data Guard Setup on $PRIMARY_SID – $status" \
            "$MAIL_TO" < "$REPORT_FILE" \
            && info "Report emailed to $MAIL_TO" \
            || warn "Email send failed."
    fi
}

# ─────────────────────────────────────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────────────────────────────────────
main() {
    sep
    echo -e "${BOLD}  Oracle Data Guard Setup  |  PRIMARY: $PRIMARY_SID  →  STANDBY: $STANDBY_SID  |  $START_TS${RESET}"
    sep

    preflight
    enable_archivelog
    enable_force_logging
    configure_primary_params
    add_standby_redo_logs
    copy_password_file
    create_standby_pfile
    configure_tns
    prepare_standby_dirs
    start_standby_nomount
    rman_duplicate
    add_standby_redo_logs_standby
    start_managed_recovery
    configure_dgbroker
    set_protection_mode
    verify_dataguard

    sep
    if (( STEP_ERRORS == 0 )); then
        ok "DATA GUARD SETUP COMPLETED SUCCESSFULLY"
        send_report "SUCCESS"
    else
        warn "COMPLETED WITH $STEP_ERRORS WARNING(S)/ERROR(S)"
        send_report "COMPLETED_WITH_WARNINGS"
    fi
    sep
    info "Full log : $LOG_FILE"
    info "Report   : $REPORT_FILE"
    sep
}

# ─────────────────────────────────────────────────────────────────────────────
# ARGUMENT HANDLING
# ─────────────────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
Usage: sudo $SCRIPT_NAME [OPTIONS]

OPTIONS
  --primary-sid     SID     Primary database SID         (default: $PRIMARY_SID)
  --standby-sid     SID     Standby database SID          (default: $STANDBY_SID)
  --primary-host    HOST    Primary hostname              (default: $PRIMARY_HOST)
  --standby-host    HOST    Standby hostname              (default: $STANDBY_HOST)
  --primary-home    PATH    Primary ORACLE_HOME
  --standby-home    PATH    Standby ORACLE_HOME
  --protection-mode MODE    MaxProtection/MaxAvailability/MaxPerformance
  --mail            EMAIL   Send report to this address
  --help                    Show this help

EXAMPLE
  sudo ./oracle_dataguard_setup.sh \\
    --primary-sid PROD \\
    --standby-sid PRODSTBY \\
    --primary-host db-primary \\
    --standby-host db-standby \\
    --mail dba@example.com
EOF
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --primary-sid)      PRIMARY_SID="$2";            shift 2 ;;
        --standby-sid)      STANDBY_SID="$2";            shift 2 ;;
        --primary-host)     PRIMARY_HOST="$2";           shift 2 ;;
        --standby-host)     STANDBY_HOST="$2";           shift 2 ;;
        --primary-home)     PRIMARY_ORACLE_HOME="$2";    shift 2 ;;
        --standby-home)     STANDBY_ORACLE_HOME="$2";    shift 2 ;;
        --protection-mode)  DG_PROTECTION_MODE="$2";     shift 2 ;;
        --mail)             MAIL_TO="$2";                shift 2 ;;
        --help)             usage ;;
        *)                  warn "Unknown option: $1";   shift ;;
    esac
done

main
